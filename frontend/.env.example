# API_URL es privada y tiene preferencia para Server Components.
API_URL=http://localhost:8080/api
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Solo desarrollo. En Vercel Production, omitir INDEXABLE o usar true tras revisar los datos.
# Preview y Development conservan noindex incluso si INDEXABLE=true.
INDEXABLE=false
# Opcional: contenido del meta tag de verificación de Google Search Console.
GOOGLE_SITE_VERIFICATION=
